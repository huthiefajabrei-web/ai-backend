# ==========================================
# AI Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Environment (development | production)
ENVIRONMENT=development

# API Keys (required)
RUNPOD_API_KEY=your_runpod_key
RUNPOD_ENDPOINT_ID=your_endpoint_id
GEMINI_API_KEY=your_gemini_key

# Firebase (required)
FIREBASE_CREDENTIALS=firebase-credentials.json
APP_STORAGE_BUCKET=your-project.appspot.com

# Public/Server API URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=10485760
SUBSCRIBE_TEST_MODE=false
ALLOWED_PROXY_HOSTS=

# Kling AI Video (required for video generation)
KLING_API_KEY=your_kling_api_key
KLING_SECRET_KEY=your_kling_secret_key
# KLING_VIDEO_MODEL=kling-v2-6
# KLING_VIDEO_MODEL_FALLBACK=kling-v1-1

# Public site URL (SEO sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://gen-lang-client-0550261552.web.app

# Frontend Firebase Web SDK (required for build)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
